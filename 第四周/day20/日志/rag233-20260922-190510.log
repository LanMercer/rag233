FROM modelscope-registry.cn-hangzhou.cr.aliyuncs.com/modelscope-repo/modelscope:ubuntu22.04-py312-torch2.10.0-1.37.1 AS deps
COPY . /src
RUN mkdir -p /deps && (cp /src/packages.txt /deps/ 2>/dev/null || true) && (cp /src/requirements.txt /deps/ 2>/dev/null || true)
FROM modelscope-registry.cn-hangzhou.cr.aliyuncs.com/modelscope-repo/modelscope:ubuntu22.04-py312-torch2.10.0-1.37.1
ADD https://modelscope-studios.oss-cn-zhangjiakou.aliyuncs.com/SDK/studio-launcher/0.1.0/studio-launcher /usr/local/bin/studio-launcher
RUN chmod +x /usr/local/bin/studio-launcher
WORKDIR /home/studio/PROJECT
COPY --from=deps /deps/ /tmp/deps/
RUN if [ -f /tmp/deps/packages.txt ]; then apt-get update && sed -e 's/#.*//' /tmp/deps/packages.txt | DEBIAN_FRONTEND=noninteractive xargs -r apt-get install -y --no-install-recommends && rm -rf /var/lib/apt/lists/*; fi
RUN pip install --no-cache-dir 'https://modelscope-studios.oss-cn-zhangjiakou.aliyuncs.com/SDK/gradio-3/gradio-4.44.0-py3-none-any.whl' && pip install --no-cache-dir 'gradio[mcp,oauth]'
RUN if [ -f /tmp/deps/requirements.txt ]; then pip install --no-cache-dir -r /tmp/deps/requirements.txt; fi
COPY . .
ENV STUDIO_SDK_TYPE=gradio STUDIO_ENTRY_FILE=app.py STUDIO_PROJECT_DIR=/home/studio/PROJECT
EXPOSE 7860
ENTRYPOINT ["/usr/local/bin/studio-launcher"]
